<% layout("/layouts/boilerplate") -%>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            
    <h3>Create a New Listing</h3>
    <form method="post" action="/tasks">
        <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input type="text" id="title" name="listing[title]" required 
        placeholder="Title"
        class="form-control">
        </div>

        <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea id="description" 
        name="listing[description]" required 
        class="form-control"></textarea>
        </div>

        <div class="mb-3">
        <label for="image" class="form-label">Image URL:</label>
        <input type="text" id="image" name="listing[image]"
        placeholder="image url" 
        class="form-control">
        </div>

        <div class="row ">
        <div class="mb-3 col-4">
        <label for="price" class="form-label">Price:</label>
        <input type="number" id="price" name="listing[price]" required 
        placeholder="Price"
        class="form-control">
        </div>

        <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country:</label>
        <input type="text" id="country" name="listing[country]" required 
        placeholder="Country"
        class="form-control">
        </div>
        </div>

        <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input type="text" id="location" name="listing[location]" required class="form-control">
        </div>

        <button type="submit" class="add-btn mt-3">Submit</button>

    </form>
    </div>
    </div>